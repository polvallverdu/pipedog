    "@pipedog/core": "workspace:*",
    "@pipedog/google": "workspace:*",
    "@pipedog/onnx": "workspace:*",
    "@pipedog/openai": "workspace:*",
    "@pipedog/resampler-wasm": "workspace:*",
    "@pipedog/runner": "workspace:*",
    "@pipedog/serializer-protobuf": "workspace:*",
    "@pipedog/serializer-telnyx": "workspace:*",
    "@pipedog/transport-smallwebrtc": "workspace:*",
    "@pipedog/transport-websocket": "workspace:*"
  },
  "devDependencies": {
    "@google-cloud/speech": "8.1.1",
    "@google-cloud/text-to-speech": "7.1.1",
    "@grpc/grpc-js": "1.14.6",

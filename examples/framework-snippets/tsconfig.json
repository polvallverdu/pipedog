{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "$lib/*": ["./sveltekit/src/lib/*"],
      "@/lib/*": ["./nextjs/lib/*"],
      "~/server/*": ["./nuxt/server/*"]
    }
  },
  "include": [
    "shared",
    "sveltekit",
    "hono",
    "bun",
    "nextjs",
    "express",
    "elysia",
    "nuxt",
    "vercel",
    "test"
  ],
  "references": [
    { "path": "../../packages/asyncio" },
    { "path": "../../packages/audio-silero" },
    { "path": "../../packages/audio-smart-turn" },
    { "path": "../../packages/core" },
    { "path": "../../packages/openai" },
    { "path": "../../packages/serializer-protobuf" },
    { "path": "../../packages/transport-smallwebrtc" },
    { "path": "../../packages/transport-websocket" }
  ]
}

{
  "name": "pipedog",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "upstream": "bun tools/upstream.ts",
    "typecheck": "tsc -b packages/*/tsconfig.json examples/*/tsconfig.json",
    "test": "bun test",
    "lint": "biome check . && bun tools/port/check-headers.ts",
    "format": "biome format --write .",
    "port:plan": "python3 -I tools/port/graph.py",
    "port:status": "bun tools/port/status.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "mcp:snapshot": "bun packages/mcp/scripts/snapshot.ts",
    "compat": "bun tools/compat/run.ts",
    "build": "tsc -b --force packages/*/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version && bun tools/release/sync-version.ts && bun install && biome format --write packages .changeset",
    "release:verify": "bun tools/release/verify.ts",
    "release": "bun run build && bun run mcp:snapshot --build && bun tools/release/prepare.ts && changeset publish",
    "release:setup-npm": "bun tools/release/setup-npm.ts",
    "bench": "bun tools/bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@pipedog/audio-silero": "workspace:*",
    "@pipedog/audio-smart-turn": "workspace:*",
    "@pipedog/core": "workspace:*",
    "@pipedog/onnx": "workspace:*",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "workerd": "1.20261005.1"
  }
}

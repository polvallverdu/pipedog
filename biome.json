{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/rust/target",
      "!packages/sentencex-wasm/src/wasm_bytes.ts",
      "!.upstream",
      "!porting",
      "!.claude",
      "!**/.next",
      "!**/.source",
      "!apps/docs/out",
      "!packages/mcp/snapshot",
      "!**/.wrangler",
      "!**/.svelte-kit",
      "!examples/landing-demo/web/build",
      "!apps/docs/next-env.d.ts",
      "!packages/runner/prebuilt",
      "!packages/cli/templates",
      "!packages/flows/src/flow_config.schema.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noBannedTypes": "off",
        "noUselessConstructor": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" },
          "style": { "useConst": "off", "useImportType": "off" }
        }
      }
    },
    {
      "includes": ["packages/cli/src/templates/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/**", "packages/asyncio/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "Core must run on edge runtimes; put Node-only code in a separate package.",
                  "node:net": "Core must run on edge runtimes; put Node-only code in a separate package.",
                  "node:buffer": "Use Uint8Array instead of Buffer."
                }
              }
            }
          }
        }
      }
    }
  ]
}

{
  "name": "@pipedog/flows",
  "version": "0.6.1",
  "description": "Pipecat Flows for pipedog: structured conversations built from nodes, edge functions and actions.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "flows",
    "llm",
    "function-calling"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/flows"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/flows#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./flow_config.schema.json": "./src/flow_config.schema.json",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@pipedog/anthropic": "workspace:*",
    "@pipedog/google": "workspace:*",
    "@pipedog/openai": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/flows"
    ]
  }

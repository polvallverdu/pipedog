{
  "name": "@pipedog/tracing",
  "version": "0.11.0",
  "description": "OpenTelemetry tracing setup for pipedog: setupTracing() with OTLP/HTTP and console exporters, on Bun, Node, Deno and Cloudflare Workers.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "opentelemetry",
    "tracing",
    "otlp"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/tracing"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/tracing#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@pipedog/core": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/utils/tracing/setup.py"
    ]
  }
}

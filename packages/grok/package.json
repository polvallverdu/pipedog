{
  "name": "@pipedog/grok",
  "version": "0.11.0",
  "description": "Deprecated alias of @pipedog/xai's Grok LLM service, for pipedog.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "xai",
    "grok",
    "llm"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/grok"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/grok#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/xai": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/services/grok/llm.py",
      "src/pipecat/services/grok/realtime",
      "src/pipecat/adapters/llm/services/grok_realtime_adapter.py"
    ]
  }

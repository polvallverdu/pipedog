{
  "name": "@pipedog/onnx",
  "version": "0.3.0",
  "description": "A tiny ONNX inference backend for pipedog models (Silero VAD, Smart Turn): onnxruntime-node when installed, else onnxruntime-web (WASM), with a Cloudflare Workers variant.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/onnx"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/onnx#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workerd": "./src/index.workerd.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/core": "workspace:*"
  },
  "peerDependencies": {
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "1.30.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "compat": {
      "usesOptionalPeers": [
        "onnxruntime-node",
        "onnxruntime-web"
      ]
    }
  }
}

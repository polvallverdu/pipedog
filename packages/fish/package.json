{
  "name": "@pipedog/fish",
  "version": "0.7.0",
  "description": "Fish Audio TTS service for pipedog.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "fish",
    "fish-audio",
    "tts",
    "speech"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/fish"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/fish#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@msgpack/msgpack": "3.1.3",
    "@pipedog/core": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/services/fish"
    ]
  }

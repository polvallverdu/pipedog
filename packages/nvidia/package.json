{
  "name": "@pipedog/nvidia",
  "version": "0.10.0",
  "description": "NVIDIA services (Nemotron Omni LLM adapter, NIM LLM/STT/TTS) for pipedog.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "nvidia",
    "llm"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/nvidia"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/nvidia#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*",
    "@pipedog/openai": "workspace:*",
    "openai": "^6.49.0"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/adapters/llm/services/nvidia_omni_adapter.py",
      "src/pipecat/services/nvidia"
    ]
  }
}

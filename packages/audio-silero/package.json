{
  "name": "@pipedog/audio-silero",
  "version": "0.5.0",
  "description": "Silero VAD (SileroVADAnalyzer) for pipedog, with the upstream silero_vad.onnx model included. Runs on onnxruntime-node or onnxruntime-web via @pipedog/onnx.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "vad",
    "silero",
    "onnx",
    "voice-activity-detection"
  ],
  "license": "BSD-2-Clause AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/audio-silero"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/audio-silero#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./silero": "./src/silero.ts",
    "./silero_vad.onnx": "./data/silero_vad.onnx"
  },
  "files": [
    "dist",
    "src",
    "data"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*",
    "@pipedog/onnx": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/audio/vad/silero.py",
      "src/pipecat/audio/vad/data/silero_vad.onnx"
    ],
    "compat": {
      "usesOptionalPeers": [
        "onnxruntime-node",
        "onnxruntime-web"
      ]
    }
  }
}

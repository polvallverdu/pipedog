    "voice-ai",
    "conversational-ai",
    "asyncai",
    "async",
    "tts",
    "text-to-speech"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/asyncai"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/asyncai#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {

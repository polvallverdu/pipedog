{
  "name": "@pipedog/mistral",
  "version": "0.5.0",
  "description": "Mistral services (LLM, Voxtral STT and TTS) for pipedog.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "mistral",
    "voxtral",
    "llm",
    "stt",
    "tts",
    "openai-compatible"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/mistral"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/mistral#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*",
    "@pipedog/openai": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/adapters/services/mistral_adapter.py",
      "src/pipecat/services/mistral"
    ]
  }
}

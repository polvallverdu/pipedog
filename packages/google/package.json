{
  "name": "@pipedog/google",
  "version": "0.10.0",
  "description": "Google services (Gemini, Cloud Speech-to-Text, Cloud Text-to-Speech) for pipedog.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "google",
    "gemini",
    "llm",
    "stt",
    "tts"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/google"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/google#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*"
  },
  "peerDependencies": {
    "@google-cloud/speech": "^8.0.0",
    "@google-cloud/text-to-speech": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/speech": {
      "optional": true
    },
    "@google-cloud/text-to-speech": {
      "optional": true
    }
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/services/google"
    ]
  },
  "devDependencies": {
    "@google-cloud/speech": "8.1.1",
    "@google-cloud/text-to-speech": "7.1.1",
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1"
  }
}

{
  "name": "@pipedog/deepgram",
  "version": "0.3.0",
  "description": "Deepgram services (STT, TTS, Flux STT and TTS) for pipedog.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/deepgram"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/deepgram#readme",

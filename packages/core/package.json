{
  "name": "@pipedog/core",
  "version": "0.2.0",
  "description": "Unofficial TypeScript port of the Pipecat core: frames, processors, pipelines, workers, observers, RTVI.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/resampler-wasm": "workspace:*",
    "@pipedog/sentencex-wasm": "workspace:*",
    "num2words-ts": "1.0.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/frames",
      "src/pipecat/processors/frame_processor.py",
      "src/pipecat/pipeline",
      "src/pipecat/workers",
      "src/pipecat/observers",
      "src/pipecat/clocks",
      "src/pipecat/utils"
    ]
  }
}

{
  "name": "@pipedog/whisper",
  "version": "0.6.1",
  "description": "Base speech-to-text service for Whisper-compatible APIs, shared by the pipedog STT services that speak the Whisper protocol.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "whisper",
    "stt",
    "speech"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/whisper"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/whisper#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*",
    "openai": "^6.49.0"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/services/whisper/base_stt.py"
    ]
  }
}

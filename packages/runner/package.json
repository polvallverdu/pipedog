{
  "name": "@pipedog/runner",
  "version": "0.6.1",
  "description": "Pipecat's development runner for pipedog: createTransport() from runner arguments, and a dev server (main()) with the prebuilt WebRTC client, SmallWebRTC signalling, telephony webhooks and WebSockets for Twilio, Telnyx, Plivo and Exotel. A fetch handler you can serve on Bun, Node and Deno or mount in any framework.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "runner",
    "telephony",
    "twilio",
    "telnyx",
    "plivo",
    "exotel",
    "webrtc",
    "dev-server"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/runner"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/runner#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src",
    "prebuilt"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*",
    "@pipedog/serializer-exotel": "workspace:*",
    "@pipedog/serializer-plivo": "workspace:*",
    "@pipedog/serializer-telnyx": "workspace:*",
    "@pipedog/serializer-twilio": "workspace:*",
    "@pipedog/transport-smallwebrtc": "workspace:*",
    "@pipedog/transport-websocket": "workspace:*",
    "livekit-server-sdk": "2.19.1"
  },
  "peerDependencies": {
    "@pipedog/transport-livekit": "workspace:*",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@pipedog/transport-livekit": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "ws": "8.22.0"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/runner/__init__.py",
      "src/pipecat/runner/livekit.py",
      "src/pipecat/runner/run.py",
      "src/pipecat/runner/types.py",
      "src/pipecat/runner/utils.py"
    ]
  }
}

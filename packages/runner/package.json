{
  "name": "@pipedog/runner",
  "version": "0.5.0",
  "description": "Telephony helpers from Pipecat's runner for pipedog: detect the phone provider (Twilio, Telnyx, Plivo, Exotel) from its first WebSocket messages and parse the call data. A partial port.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "runner",
    "telephony",
    "twilio",
    "telnyx",
    "plivo",
    "exotel"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/runner"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/runner#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/runner/__init__.py",
      "src/pipecat/runner/types.py",
      "src/pipecat/runner/utils.py"
    ]
  }
}

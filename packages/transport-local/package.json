{
  "name": "@pipedog/transport-local",
  "version": "0.8.0",
  "description": "Local audio transport for pipedog: the machine's microphone and speakers through sox or ffmpeg (no native addon), on Node, Bun and Deno.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "local-audio",
    "microphone",
    "sox",
    "ffmpeg",
    "transport"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/transport-local"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/transport-local#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno"
    ],
    "upstream": [
      "src/pipecat/transports/local/audio.py"
    ],
    "compat": {
      "unsupportedRuntimes": [
        "workerd"
      ],
      "needs": {
        "all": "sox or ffmpeg on the PATH, and a machine with audio devices.",
        "deno": "Run with --allow-run.",
        "workerd": "Not supported: Workers cannot start processes."
      }
    }
  }
}

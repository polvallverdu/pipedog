{
  "name": "@pipedog/audio-smart-turn",
  "version": "0.8.0",
  "description": "Smart Turn end-of-turn detection for pipedog: local Smart Turn v3 (core's LocalSmartTurnAnalyzerV3 wired to @pipedog/onnx, upstream model included) and HttpSmartTurnAnalyzer for a remote endpoint.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "turn-detection",
    "smart-turn",
    "onnx",
    "end-of-turn",
    "http"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/audio-smart-turn"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/audio-smart-turn#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./smart_turn/http_smart_turn": "./src/smart_turn/http_smart_turn.ts",
    "./smart-turn-v3.2-cpu.onnx": "./data/smart-turn-v3.2-cpu.onnx"
  },
  "files": [
    "dist",
    "src",
    "data"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*",
    "@pipedog/onnx": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/audio/turn/smart_turn/http_smart_turn.py",
      "src/pipecat/audio/turn/smart_turn/data/smart-turn-v3.2-cpu.onnx"
    ],
    "compat": {
      "usesOptionalPeers": [
        "onnxruntime-node",
        "onnxruntime-web"
      ],
      "needs": {
        "all": "Local Smart Turn v3: onnxruntime-node or onnxruntime-web. HttpSmartTurnAnalyzer: only fetch and a Smart Turn endpoint.",
        "workerd": "Local Smart Turn: pass the model's bytes (there is no filesystem). HttpSmartTurnAnalyzer needs nothing extra."
      }
    }
  }
}

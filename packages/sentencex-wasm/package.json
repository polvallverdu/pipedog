{
  "name": "@pipedog/sentencex-wasm",
  "version": "0.5.0",
  "description": "Wikimedia sentencex sentence segmentation (the Rust core, compiled to WebAssembly) for pipedog: synchronous segment() and getSentenceBoundaries() on Bun, Node, Deno and Cloudflare Workers.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "sentence-segmentation",
    "nlp",
    "wasm"
  ],
  "license": "BSD-2-Clause AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/sentencex-wasm"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/sentencex-wasm#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workerd": "./src/workerd.ts",
      "default": "./src/index.ts"
    },
    "./engine": "./src/engine.ts",
    "./sentencex.wasm": "./wasm/sentencex.wasm"
  },
  "files": [
    "dist",
    "src",
    "wasm",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/src",
    "LICENSE-sentencex"
  ],
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "sentencex": "1.0.32"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ]
  }
}

{
  "name": "@pipedog/anthropic",
  "version": "0.10.0",
  "description": "Anthropic services (Claude LLM) for pipedog.",
  "keywords": [
    "pipecat",
    "pipedog",
    "voice-ai",
    "conversational-ai",
    "realtime",
    "anthropic",
    "claude",
    "llm"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/pipedog.git",
    "directory": "packages/anthropic"
  },
  "homepage": "https://github.com/polvallverdu/pipedog/tree/main/packages/anthropic#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/pipedog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@pipedog/asyncio": "workspace:*",
    "@pipedog/core": "workspace:*"
  },
  "pipecat": {
    "runtimes": [
      "bun",
      "node",
      "deno",
      "workerd"
    ],
    "upstream": [
      "src/pipecat/adapters/llm/services/anthropic_adapter.py",
      "src/pipecat/services/anthropic"
    ]
  }
}
